# 统一换行为 LF + 锁文本编码, 修跨平台 CRLF 警告与 GBK/UTF-8 乱码
* text=auto eol=lf

# 源码/配置: 强制 LF
*.sh    text eol=lf
*.py    text eol=lf
*.launch text eol=lf
*.xml   text eol=lf
*.lua   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.cfg   text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf

# 二进制: 不做换行/编码转换
*.pgm   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.STL   binary
*.stl   binary
*.dae   binary
*.mp3   binary
*.wav   binary
*.bag   binary
*.pyc   binary

# 生成物: GitHub 折叠 diff, 减噪
docs/团队必读文档汇总.html linguist-generated=true

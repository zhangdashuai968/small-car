<?xml version="1.0"?>
<launch>
  <arg name="source_mode" default="yolo"/>
  <arg name="target_class" default=""/>
  <arg name="expected_x"/>
  <arg name="expected_y"/>
  <arg name="expected_z"/>
  <arg name="required_attempts" default="20"/>
  <arg name="capture_timeout" default="120.0"/>
  <arg name="output_path" default="/tmp/rgbd_accuracy_gate.json"/>

  <node pkg="vl_locate"
        type="rgbd_accuracy_gate.py"
        name="rgbd_accuracy_gate"
        output="screen"
        required="true">
    <param name="source_mode" value="$(arg source_mode)"/>
    <param name="target_class" value="$(arg target_class)"/>
    <param name="expected_x" value="$(arg expected_x)"/>
    <param name="expected_y" value="$(arg expected_y)"/>
    <param name="expected_z" value="$(arg expected_z)"/>
    <param name="required_attempts" value="$(arg required_attempts)"/>
    <param name="capture_timeout" value="$(arg capture_timeout)"/>
    <param name="output_path" value="$(arg output_path)"/>
    <param name="output_frame" value="camera_rgb_optical_frame"/>
    <param name="min_valid_rate" value="0.90"/>
    <param name="max_median_error" value="0.020"/>
    <param name="max_p95_error" value="0.040"/>
  </node>
</launch>

<?xml version="1.0"?>
<launch>
    <!-- VLM 参数 -->
    <rosparam file="$(find vl_locate)/config/vlm_params.yaml" command="load" ns="vlm_detection_node" />

    <!-- 摄像头: Astra Gemini RGB -->
    <node pkg="astra_camera" type="camera_node" name="gemini" output="screen">
        <param name="vendor" value="0x2bc5"/>
        <param name="product" value="0x0511"/>
        <param name="width" value="640"/>
        <param name="height" value="480"/>
        <param name="video_mode" value="mjpeg"/>
        <param name="frame_rate" value="15"/>
        <remap from="/image_raw" to="/camera/rgb/image_raw"/>
    </node>

    <!-- 图像缩放: /camera/rgb/image_raw → /new_topic -->
    <node name="image_zoomer" pkg="vl_locate" type="resize_gpu.sh" output="screen" />

    <!-- VLM 检测服务 -->
    <node name="vlm_detection_node" pkg="vl_locate" type="server.py" output="screen">
        <param name="mode" value="openai" />
    </node>
</launch>

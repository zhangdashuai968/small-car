<?xml version="1.0"?>
<launch>
    <include file="$(find abot_description)/launch/display.launch"/>
    <!-- 启动RViz -->
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find vl_locate)/rviz/nav.rviz"/>
    <!-- 加载参数文件 -->
    <rosparam file="$(find vl_locate)/config/vlm_params.yaml" command="load" ns="vlm_detection_node" />
    <include file="$(find abot)/launch/camera.launch"/>
    <!-- 启动VLM检测节点 -->
    <node name="vlm_detection_node" pkg="vl_locate" type="server.py" output="screen">
        <!-- 节点特定参数 -->
        <param name="mode" value="dashscope" />
    </node>
    <node name='image_zoomer'  pkg="vl_locate" type="resize.py" output="screen" />
    
    <!--启动图像查看器 -->
    <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
        <remap from="image" to="/new_topic" />
    </node> 

</launch>

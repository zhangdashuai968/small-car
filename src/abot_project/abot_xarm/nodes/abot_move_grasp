    def TransformPose(self):
        cx = self.acent[0];cy = self.acent[1];cz = self.acent[2]
        tx = self.atop[0];ty = self.atop[1];tz = self.atop[2]

        a = ((cx-tx)*(self.ccent[0]-self.ctop[0])+\
                  (cy-ty)*(self.ccent[1]-self.ctop[1]))/\
                  (pow((self.ccent[1]-self.ctop[1]), 2)+ pow((self.ccent[0]- self.ctop[0]), 2))
        b = ((cy-ty)*(self.ccent[0]-self.ctop[0]) - \
                (cx-ty)*(self.ccent[1]-self.ctop[1]))/\
                (pow((self.ccent[1]-self.ctop[1]), 2)+pow((self.ccent[0] - self.ctop[0]), 2))
        c = cx - a*self.ccent[0] + b*self.ccent[1]
        d = cy - b*self.ccent[0] - a*self.ccent[1]

        self.x = self.obj_y*a - self.obj_x*b + c 
        self.y = self.obj_y*b + self.obj_x*a + d
        self.z = cz


        rospy.loginfo("Get object: a: %f, b: %f, c: %f, d : %f, x: %d, y: %d, z: %d, r: %d", a, b, c, d, self.x, self.y, self.z, self.rotary)

    def xArmGraspPlan(self):
        #self.xArmGripperTxData(GRIPPER_OPEN)
        #time.sleep(2)
        self.TransformPose()
        time.sleep(2)
        self.xArmPoseTxData(self.x, self.y, self.z, self.rotary)
        time.sleep(2)
        self.xArmGripperTxData(GRIPPER_CLOSE)
        time.sleep(2)
        self.xArmPoseTxData(80, 0, 250)
        time.sleep(2)
        if self.fix_grasp_mode is True:
            self.xArmGripperTxData(GRIPPER_OPEN)
            time.sleep(2)
            self.xArmHome()
            time.sleep(2)
        self.grasp_lock = False
        self.goal_lock = False
        self.grasp_finish = True

    def xArmPlacePlan(self):
        self.xArmPoseTxData(250, 0, 50)
        time.sleep(2)
        self.xArmGripperTxData(GRIPPER_OPEN)
        time.sleep(2)
        self.xArmHome()
        time.sleep(2)

    def cbGetxArmPoseParam(self, config, level):
        rospy.loginfo("Rikibot Xarm Pose Calib")
        rospy.loginfo("x : %d", config.x)
        rospy.loginfo("y : %d", config.y)
        rospy.loginfo("z : %d", config.z)
        rospy.loginfo("rotary : %d", config.rotary)

        self.x = config.x
        self.y = config.y
        self.z = config.z
        self.rotary = config.rotary
        return config


    def xArmPoseTxData(self, x, y, z, rotary=90):
        xArmPose = {"RikibotxArmCmd": 1,"Pose": {"x": x, "y": y, "z": z, "rotary": rotary},"time": self.speed}
        self.xArmCtrl.SerialWriteData(json.dumps(xArmPose))

    def xArmGripperTxData(self, gripper_step):
        xArmGripper = {"RikibotxArmCmd": 2, "Gripper": gripper_step, "time": self.speed }
        self.xArmCtrl.SerialWriteData(json.dumps(xArmGripper))


    def xArmHome(self):
        gripper_step = 200
        self.xArmPoseTxData(80, 0, 250)
        time.sleep(1)
        self.xArmGripperTxData(gripper_step)

    def SendGoal(self, goal):
        # Set up the next goal location
        self.goal = MoveBaseGoal()
        #self.goal.target_pose.pose = self.locations[locate]
        self.goal.target_pose.pose = goal
        self.goal.target_pose.header.frame_id = 'map'
        self.goal.target_pose.header.stamp = rospy.Time.now()
        self.move_base.send_goal(self.goal) #send goal to move_base

    def main(self):
        rospy.spin()

    def shutdown(self):
        # Release handle to the webcam
        rospy.logwarn("now will shutdown xarm ...")



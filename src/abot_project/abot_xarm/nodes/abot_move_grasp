        #if self.pub_image_type == "compressed":
        #    self.pub_detect_image = rospy.Publisher('/detect_image/compressed', CompressedImage, queue_size=1)
        #else:   
        #    self.pub_detect_image = rospy.Publisher('/detect_image', Image, queue_size=1)

 
        self.cvBridge = CvBridge()
        self.obj_detection = ObjectDetection()
        self.xArmCtrl = RikibotxArmCtrl(port=self.port, baud=self.baud)

        self.count = 0
        self.move_count = 0

        self.color = (0, 0, 255)
        self.acent = list(map(float, self.arm_center.split(',')))
        self.atop = list(map(float, self.arm_top.split(',')))
        self.ccent = [220.0, 320.0]
        #self.ccent = [220.0, 400.0]
        self.ctop = [150.0, 320.0]
        self.obj_x = 0
        self.obj_y = 0
        self.last_x = self.last_y = self.last_z = self.last_rotary = 0
        self.grasp_lock = False
        self.grasp_finish = False
        self.goal_lock = False
        self.obj_color = 'red'
        self.angle = 0

        self.nav_step = 0
        #grasp_pose = [3.552, -1.372, 0.000]
        #grasp_quat = [0.000, 0.000, 1.000, 0.010]
        #place_pose = [-0.049,  -0.853, 0]
        #place_quat = [0.000, 0.000, -0.024, 1.000]
        grasp_pose = list(map(float, self.obj_grasp_pose.split(',')))
        grasp_quat = list(map(float, self.obj_grasp_quat.split(',')))
        place_pose = list(map(float, self.obj_place_pose.split(',')))
        place_quat = list(map(float, self.obj_place_quat.split(',')))
        self.GraspGoalOffset = Pose(Point(grasp_pose[0] - self.postion_offset, grasp_pose[1], grasp_pose[2]), Quaternion(grasp_quat[0], grasp_quat[1], grasp_quat[2], grasp_quat[3]))
        self.GraspGoal = Pose(Point(grasp_pose[0], grasp_pose[1], grasp_pose[2]), Quaternion(grasp_quat[0], grasp_quat[1], grasp_quat[2], grasp_quat[3]))
        self.PlaceGoalOffset = Pose(Point(place_pose[0] + self.postion_offset, place_pose[1], place_pose[2]), Quaternion(place_quat[0], place_quat[1], place_quat[2], place_quat[3]))
        self.PlaceGoal = Pose(Point(place_pose[0], place_pose[1], place_pose[2]), Quaternion(place_quat[0], place_quat[1], place_quat[2], place_quat[3]))

       
        if self.fix_grasp_mode is False or self.is_calibration_mode is True:
            self.nav = RikibotNav()

        if self.is_calibration_mode is False:
            self.xArmHome()

        self.xArmGripperTxData(GRIPPER_OPEN)


        while not rospy.is_shutdown():
            if self.fix_grasp_mode is False:
                if self.goal_lock is True:
                    if self.grasp_lock is True:
                        rospy.loginfo("object pos: x: %d, y: %d", self.obj_x, self.obj_y) 
                        self.xArmGraspPlan()
                else:
                    self.MoveSingleGrasp()

            else:
                if self.grasp_lock is True:
                    rospy.loginfo("object pos: x: %d, y: %d", self.obj_x, self.obj_y) 
                    self.xArmGraspPlan()

            r.sleep()

    def MoveSingleGrasp(self):
        if self.nav_step == 0:
            self.nav.SendGoal(self.GraspGoalOffset)
        if self.nav_step == 1:
            self.nav.SendGoal(self.GraspGoal)
        if self.nav_step == 2 and self.grasp_finish is True:
            self.nav.SendGoal(self.PlaceGoalOffset)
        if self.nav_step == 3:
            self.nav.SendGoal(self.PlaceGoal)
        if self.nav_step == 4:
            self.xArmPlacePlan()
            
        state =self.nav.NavState()
        if state == 1:
            self.nav_step = self.nav_step + 1
            if self.nav_step == 2:
                self.goal_lock  = True



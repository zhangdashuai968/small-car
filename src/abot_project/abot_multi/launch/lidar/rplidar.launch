<launch>
  <arg name="car_type" value="$(env ABOTMODEL)"/>
  <arg name="lidar_frame" default="laser"/>
  <arg name="robot_name"  default="$(env ROBOT_NAME)"/>
  <node name="rplidarNode"          pkg="rplidar_ros"  type="rplidarNode" output="screen">
  	<param name="serial_port"         type="string" value="/dev/abotlidar"/>
  	<param name="serial_baudrate"     type="int"    value="115200"/><!--A1/A2 -->
  	<!--param name="serial_baudrate"     type="int"    value="256000"--><!--A3 -->
  	<param name="frame_id"            type="string" value="$(arg lidar_frame)"/>
  	<param name="inverted"            type="bool"   value="false"/>
  	<param name="angle_compensate"    type="bool"   value="true"/>
  </node>

  <group if="$(eval arg('car_type') == 'x4')">
  	<node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_laser" args="0.04 0 0.18 0 0 0  $(arg robot_name)/base_link $(arg robot_name)/laser"/>
  </group>

  <group if="$(eval arg('car_type') == 'xs')">
  	<node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_laser" args="0.12 0 0.18 0 0 0  $(arg robot_name)/base_link $(arg robot_name)/laser"/>
  </group>

  <group if="$(eval arg('car_type') == 'xarm')">
  	<node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_laser" args="0.11 0 0.18 0 0 0  $(arg robot_name)/base_link $(arg robot_name)/laser"/>
  </group>

  <group if="$(eval arg('car_type') == 'fx4')">
  	<node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_laser" args="0.12 0 0.3 0 0 0  $(arg robot_name)/base_link $(arg robot_name)/laser"/>
  </group>

</launch>


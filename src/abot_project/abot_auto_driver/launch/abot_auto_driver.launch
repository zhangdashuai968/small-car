<launch>
     <arg name="camera_type" value="$(env CAMERA)"/>
     <arg if="$(eval arg('camera_type') == 'astra')" name="input_image"      default="/camera/rgb/image_raw"/>
     <arg if="$(eval arg('camera_type') == 'astrapro')" name="input_image"   default="/camera/rgb/image_raw"/>
     <arg if="$(eval arg('camera_type') == 'usb')" name="input_image"        default="/camera/rgb/image_raw"/>
     <arg if="$(eval arg('camera_type') == 'csi')" name="input_image"        default="/camera/rgb/image_raw"/>
     <arg if="$(eval arg('camera_type') == 'intel')" name="input_image"      default="/camera/color/image_raw"/>

     <include file="$(find abot)/launch/camera.launch"/>
     <include file="$(find abot_yolo_detection)/launch/abot_traffic.launch"/>


      <node name='driver_way_node' pkg="abot_auto_driver" type="driver_way.py" output="screen">
        <param name="outer_ring_center_target" value="0.18" type="double" />        
        <param name="outer_ring_vel_z_P" value="0.007" type="double" />      
        <param name="outer_ring_vel_z_D" value="0.003" type="double" />
        <param name="Inner_ring_center_target" value="0.95" type="double" />
        <param name="Inner_ring_vel_y_P" value="0.0005" type="double" />
        <param name="Inner_ring_vel_y_D" value="0.003" type="double" />
        <param name="Inner_ring_vel_z_P" value="0.006" type="double" />
        <param name="Inner_ring_vel_z_D" value="0.001" type="double" />
      </node>   
      <node name='abot_auto_run' pkg="abot_auto_driver" type="auto_run.py" output="screen">
	<param name="camera_topic" value="$(arg input_image)" type="string" />
      </node> 
</launch>

<?xml version="1.0" encoding="utf-8"?>
<launch>
  <arg name="camera_type" value="$(env CAMERA)"/>
  <arg if="$(eval arg('camera_type') == 'astra')" name="input_image" default="/camera/rgb/image_raw"/>
  <arg if="$(eval arg('camera_type') == 'astrapro')" name="input_image" default="/camera/rgb/image_raw"/>
  <arg if="$(eval arg('camera_type') == 'gemini')" name="input_image" default="/camera/rgb/image_raw"/>
  <arg if="$(eval arg('camera_type') == 'usb')" name="input_image" default="/camera/rgb/image_raw"/>
  <arg if="$(eval arg('camera_type') == 'csi')" name="input_image" default="/camera/rgb/image_raw"/>
  <arg if="$(eval arg('camera_type') == 'intel')" name="input_image" default="/camera/color/image_raw"/>

  <arg name="weight_path" default="$(find abot_yolov5)/weights/yolov5n.pt"/>
  <arg name="data_path" default="$(find abot_yolov5)/yolov5/data/coco128.yaml"/>
  <arg name="device" default="0"/>
  <arg name="half" default="true"/>
  <arg name="input_width" default="640"/>
  <arg name="input_height" default="384"/>
  <arg name="conf" default="0.3"/>
  <arg name="iou" default="0.45"/>
  <arg name="max_det" default="100"/>
  <arg name="publish_debug_image" default="false"/>

  <param name="yolov5_path" value="$(find abot_yolov5)/yolov5"/>
  <node pkg="abot_yolov5"
        type="yolov5_node.py"
        name="yolov5"
        output="screen">
    <param name="weight_path" value="$(arg weight_path)"/>
    <param name="data_path" value="$(arg data_path)"/>
    <param name="image_topic" value="$(arg input_image)"/>
    <param name="pub_topic" value="/yolov5/BoundingBoxes"/>
    <param name="device" value="$(arg device)"/>
    <param name="half" value="$(arg half)"/>
    <param name="input_width" value="$(arg input_width)"/>
    <param name="input_height" value="$(arg input_height)"/>
    <param name="conf" value="$(arg conf)"/>
    <param name="iou" value="$(arg iou)"/>
    <param name="max_det" value="$(arg max_det)"/>
    <param name="publish_debug_image" value="$(arg publish_debug_image)"/>
  </node>
</launch>
